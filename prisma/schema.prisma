// Prisma schema for moto-repo — a social platform for motorcycle enthusiasts.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Queries go through Neon's pooler: serverless opens a connection per
  // invocation and would otherwise exhaust the server's limit.
  url       = env("DATABASE_URL")
  // Migrations don't. They issue DDL and advisory locks that a transaction-mode
  // pooler can't carry, so they need the direct endpoint — same database, no
  // pgbouncer in front. Both are injected by the Neon integration.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Post {
  id        String   @id @default(cuid())
  author    String
  content   String
  createdAt DateTime @default(now())

  // Optional attached image, stored as a local path under /uploads (the bytes
  // live on disk in public/uploads, not in the DB).
  imageUrl String?

  // Optional link to a real account. Kept nullable + `author` denormalized so
  // legacy/seeded posts (and anonymous posts) still render.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  comments Comment[]
  waves    Wave[]

  @@index([createdAt])
}

// A rider's wave on a post — this app's "like". Named after the two-finger
// salute riders give each other on the road. One row per waver per post; the
// unique pairs below are what make waving idempotent, so a double tap or an
// offline retry can't inflate the count.
//
// Exactly one of `userId` / `guestId` is set. `guestId` exists only for the
// anonymous-waves toggle (NEXT_PUBLIC_ALLOW_ANONYMOUS_WAVES): a signed-out
// visitor is identified by a random id in a cookie, so their wave persists and
// can be taken back, but it isn't tied to any account. Both columns are
// nullable because a unique index treats NULLs as distinct — that's what lets
// many signed-in rows share `guestId = NULL` and vice versa. (True of Postgres
// as it was of SQLite: NULLS DISTINCT is the default.)
model Wave {
  id        String   @id @default(cuid())
  postId    String
  userId    String?
  guestId   String?
  createdAt DateTime @default(now())

  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@unique([postId, guestId])
  @@index([postId])
}

// A reply on a post, shown in the scrolling ticker along the bottom of the
// post card. Unlike Post, `userId` is required — commenting needs an account.
// `author` is still denormalized to match Post and to keep ticker rendering
// cheap (no join needed for the collapsed strip).
model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  author    String
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// A rider's most recent shared position. One row per rider handle — we upsert
// on each update rather than keeping a full history (keeps the "live" query
// trivial). `sharing = false` means the rider has gone invisible.
model Location {
  id        String   @id @default(cuid())
  rider     String   @unique
  lat       Float
  lng       Float
  accuracy  Float?
  sharing   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  handle       String   @unique
  displayName  String?
  bio          String?
  passwordHash String
  // Base avatar skin tone (hex). Equipped gear layers on top of this.
  avatarSkin   String   @default("#c68642")
  createdAt    DateTime @default(now())

  posts         Post[]
  comments      Comment[]
  waves         Wave[]
  gear          UserGear[]
  motorcycles   Motorcycle[]
  rooms         Room[]
  conversations Participant[]
  messages      Message[]
}

// A voice room in Comms — the intercom. Opened by a rider, who is its host:
// opening a room *is* taking the first of the four mic seats, so a room never
// exists with nobody talking in it.
//
// This is a session, not a channel. It lives while people are in it and
// `closedAt` retires it, which is what makes the directory "what's happening
// now" rather than a list of dead rooms. Topics are tags picked when the room
// is opened, not permanent places — the title is what actually fills a room,
// and the host can rewrite it while live as the conversation drifts.
//
// Who's on the floor is deliberately *not* here: mic rights are LiveKit
// participant permissions, which is the only copy that can't drift from what
// the server will actually accept audio from.
model Room {
  id       String    @id @default(cuid())
  title    String
  topic    String // maintenance | rally | gear | general
  hostId   String
  openedAt DateTime  @default(now())
  closedAt DateTime?

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // NOTE: the migration also creates a *partial* unique index —
  //   CREATE UNIQUE INDEX "Room_one_open_per_host" ON "Room"("hostId")
  //     WHERE "closedAt" IS NULL;
  // — which is what actually enforces one open room per host. Prisma's schema
  // language can't express a partial index, so it isn't declared above and
  // `migrate dev` will report it as drift. It is deliberate: keep it.

  // The directory's one query: live rooms, newest first. `closedAt` leads
  // because every listing filters on it.
  @@index([closedAt, openedAt])
  @@index([hostId])
}

// A bike in a rider's garage, shown on their profile.
model Motorcycle {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  make      String
  model     String
  nickname  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Catalog of cosmetic gear. `id` is a stable slug so seeds are idempotent.
// `asset` maps to a drawing in the SVG shape registry (no binary assets).
model GearItem {
  id      String  @id
  slot    String // helmet | jacket | visor | background
  name    String
  brand   String?
  rarity  String  @default("common")
  asset   String
  color   String?
  // Granted to every new account on signup (the free starter set).
  starter Boolean @default(false)

  owners UserGear[]

  @@index([slot])
}

// A user's ownership of a gear item, plus whether it's currently equipped.
// At most one equipped item per slot is enforced in application logic.
model UserGear {
  id         String   @id @default(cuid())
  userId     String
  gearItemId String
  equipped   Boolean  @default(false)
  // How it was acquired: starter today; "code" once brand redemption lands.
  source     String   @default("starter")
  acquiredAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gearItem GearItem @relation(fields: [gearItemId], references: [id], onDelete: Cascade)

  @@unique([userId, gearItemId])
  @@index([userId])
}

// A 1:1 direct message thread. Unlike a Room this is a *place*, not a session:
// it has no open/closed state, it outlives every message in it, and it's found
// by who's in it rather than by what it's about.
//
// `pairKey` is the two user ids sorted and joined with ":". It's unique, so
// "start a DM with @x" is an upsert that can't race into two conversations for
// the same pair — the same idempotency-via-unique-constraint move Wave makes
// with @@unique([postId, userId]). Sorting is what makes it symmetric: A→B and
// B→A produce the same key, so the two directions can't each mint a thread.
model Conversation {
  id      String @id @default(cuid())
  pairKey String @unique

  createdAt     DateTime @default(now())
  // Denormalized so the inbox can sort without touching Message. Bumped in the
  // same transaction as the insert that moved it.
  lastMessageAt DateTime @default(now())

  participants Participant[]
  messages     Message[]

  @@index([lastMessageAt])
}

// One side of a conversation. A join table rather than aId/bId columns on
// Conversation, because read state is *per side* and needs somewhere to live —
// and because it leaves group threads possible later without a migration that
// rewrites what's already there.
model Participant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  // Bumped on the *other* participant's row when a message lands, zeroed when
  // they open the thread. Denormalized because the header polls it constantly
  // and a live COUNT over Message would be the app's most-run query.
  //
  // A 40-message burst is one unread conversation here, not 40 notifications:
  // the count that matters is how many threads are waiting on you.
  unreadCount    Int       @default(0)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per side, and the guard that makes the start-a-thread upsert safe.
  @@unique([conversationId, userId])
  // The inbox query: every conversation I'm in.
  @@index([userId])
}

// A message in a thread. No `author` denormalization, unlike Post and Comment:
// a thread has exactly two people in it and always joins them anyway, so the
// handle is free on read — and this way a handle change is reflected rather
// than frozen into every line the rider ever sent (the newer preference, noted
// in the Room comment above).
model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Both of the thread's queries: render it oldest-first, and fetch "anything
  // after this timestamp" on each poll tick.
  @@index([conversationId, createdAt])
}
