generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Queries go through Neon's pooler; migrations can't (a transaction-mode
  // pooler can't carry DDL and advisory locks) and need the direct endpoint.
  // Same database. Both URLs are injected by the Neon integration.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Post {
  id        String   @id @default(cuid())
  author    String
  content   String
  createdAt DateTime @default(now())

  // Local path under /uploads; the bytes live on disk in public/uploads.
  imageUrl String?

  // Nullable, with `author` denormalized alongside it, so legacy/seeded and
  // anonymous posts still render.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  comments      Comment[]
  waves         Wave[]
  notifications Notification[]

  @@index([createdAt])
}

// A rider's wave on a post — this app's "like". The unique pairs below are what
// make waving idempotent, so a double tap or an offline retry can't inflate the
// count.
//
// Exactly one of `userId` / `guestId` is set. `guestId` exists only for the
// anonymous-waves toggle (NEXT_PUBLIC_ALLOW_ANONYMOUS_WAVES): a signed-out
// visitor is identified by a random id in a cookie. Both columns are nullable
// because a unique index treats NULLs as distinct — that's what lets many
// signed-in rows share `guestId = NULL` and vice versa.
model Wave {
  id        String   @id @default(cuid())
  postId    String
  userId    String?
  guestId   String?
  createdAt DateTime @default(now())

  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@unique([postId, guestId])
  @@index([postId])
}

// A reply on a post. `author` is denormalized to match Post and to keep the
// collapsed ticker strip renderable without a join.
model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  author    String
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@index([postId, createdAt])
}

// A rider's most recent shared position. One row per rider handle, upserted on
// each update rather than keeping a full history, which keeps the "live" query
// trivial.
model Location {
  id        String   @id @default(cuid())
  rider     String   @unique
  lat       Float
  lng       Float
  accuracy  Float?
  sharing   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  handle       String  @unique
  displayName  String?
  bio          String?
  passwordHash String
  avatarSkin   String  @default("#c68642")

  // Inseam in whole millimetres — see ADR 0006.
  //
  // PRIVATE. Body data, and there is no permission layer yet, so it must never
  // leave the owner's own session — what's shareable is the verdict ("flat-foots
  // a Rebel 500"), not the number.
  inseamMm       Int?
  // "typed" (tape against a wall) | "photo" (browser-side pose estimate).
  inseamSource   String?
  // Spread across the three captures, in mm. Null on the typed path. Drives the
  // borderline flag.
  inseamSpreadMm Int?

  createdAt DateTime @default(now())

  posts         Post[]
  comments      Comment[]
  waves         Wave[]
  gear          UserGear[]
  motorcycles   Motorcycle[]
  rooms         Room[]
  conversations Participant[]
  messages      Message[]

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsActed    Notification[] @relation("NotificationActor")
}

// A voice room in Comms — the intercom. Opening a room *is* taking the first of
// the four mic seats, so a room never exists with nobody talking in it.
//
// This is a session, not a channel: `closedAt` retires it, which is what makes
// the directory "what's happening now" rather than a list of dead rooms.
//
// Who's on the floor is deliberately *not* here: mic rights are LiveKit
// participant permissions, the only copy that can't drift from what the server
// will actually accept audio from.
model Room {
  id       String    @id @default(cuid())
  title    String
  topic    String // maintenance | rally | gear | general
  hostId   String
  openedAt DateTime  @default(now())
  closedAt DateTime?

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // NOTE: the migration also creates a *partial* unique index —
  //   CREATE UNIQUE INDEX "Room_one_open_per_host" ON "Room"("hostId")
  //     WHERE "closedAt" IS NULL;
  // — which is what actually enforces one open room per host. Prisma's schema
  // language can't express a partial index, so it isn't declared above and
  // `migrate dev` will report it as drift. It is deliberate: keep it.

  // The directory's one query: live rooms, newest first. `closedAt` leads
  // because every listing filters on it.
  @@index([closedAt, openedAt])
  @@index([hostId])
}

model Motorcycle {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  make      String
  model     String
  nickname  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Catalog of cosmetic gear. `id` is a stable slug so seeds are idempotent.
// `asset` maps to a drawing in the SVG shape registry (no binary assets).
model GearItem {
  id      String  @id
  slot    String // helmet | jacket | visor | background
  name    String
  brand   String?
  rarity  String  @default("common")
  asset   String
  color   String?
  // Granted to every new account on signup.
  starter Boolean @default(false)

  owners UserGear[]

  @@index([slot])
}

// A user's ownership of a gear item. At most one equipped item per slot, which
// is enforced in application logic, not here.
model UserGear {
  id         String   @id @default(cuid())
  userId     String
  gearItemId String
  equipped   Boolean  @default(false)
  // "starter" | "code" (brand redemption, not yet live).
  source     String   @default("starter")
  acquiredAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gearItem GearItem @relation(fields: [gearItemId], references: [id], onDelete: Cascade)

  @@unique([userId, gearItemId])
  @@index([userId])
}

// A 1:1 direct message thread — see ADR 0003 (and 0001).
//
// `pairKey` is the two user ids sorted and joined with ":". Sorting is what
// makes it symmetric, and the unique constraint makes "start a DM with @x" an
// upsert that can't race into two conversations for the same pair — the same
// idempotency-via-unique-constraint move Wave makes.
model Conversation {
  id      String @id @default(cuid())
  pairKey String @unique

  createdAt     DateTime @default(now())
  // Denormalized so the inbox can sort without touching Message. Bumped in the
  // same transaction as the insert that moved it.
  lastMessageAt DateTime @default(now())

  participants Participant[]
  messages     Message[]

  @@index([lastMessageAt])
}

// One side of a conversation. A join table rather than aId/bId columns on
// Conversation, because read state is *per side* and needs somewhere to live,
// and because it leaves group threads possible later.
model Participant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  // Bumped on the *other* participant's row when a message lands, zeroed when
  // they open the thread. Denormalized because the header polls it constantly
  // and a live COUNT over Message would be the app's most-run query.
  //
  // A 40-message burst is one unread conversation here, not 40 notifications.
  unreadCount    Int       @default(0)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per side, and the guard that makes the start-a-thread upsert safe.
  @@unique([conversationId, userId])
  // The inbox query: every conversation I'm in.
  @@index([userId])
}

// A message in a thread. No `author` denormalization, unlike Post and Comment:
// a thread has two people in it and always joins them anyway, so the handle is
// free on read and a handle change is reflected rather than frozen into every
// line the rider ever sent.
model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Both of the thread's queries: render it oldest-first, and fetch "anything
  // after this timestamp" on each poll tick.
  @@index([conversationId, createdAt])
}

// Something that happened to a rider's posts — see ADR 0007.
//
// DMs are deliberately NOT here: unread mail is Participant.unreadCount, a
// counter, because forty messages from one rider is one conversation waiting on
// you, while a wave and a comment are two things and get a row each. The badge
// adds the two counts.
//
// Both ends are accounts, enforced here rather than at the call sites: a
// signed-out visitor can still wave while ANONYMOUS_WAVES_ENABLED is on, and
// that wave notifies nobody — "someone waved" names nobody and links nowhere.
// Nothing about the actor is copied onto the row, so a handle change is
// reflected on read.
model Notification {
  id          String @id @default(cuid())
  recipientId String
  actorId     String
  // "wave" | "comment" — see NOTIFICATION_TYPES in src/lib/notifications.ts.
  // A bare String with a type guard beside it, per house convention; no enums.
  type        String

  // Which thing it happened to. Nullable because not every type carries both —
  // a wave has no comment — and a type added later may carry neither. Real
  // foreign keys rather than loose ids, so a deleted post can't leave a row
  // saying somebody waved at nothing.
  postId    String?
  commentId String?

  createdAt DateTime  @default(now())
  // Set once when the rider reads it and never unset, which is what makes a
  // repeat "mark read" harmless — the same reason the DM read route writes a
  // fixed 0 rather than decrementing.
  readAt    DateTime?

  recipient User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // The panel: my notifications, newest first, and the ?before= cursor pages
  // down the same index.
  @@index([recipientId, createdAt])
  // The badge count, which runs on a timer in every open tab and is the query
  // whose cost multiplies. Also the wave dedupe guard's lookup, which filters
  // this down by actor and post.
  @@index([recipientId, readAt])
}
