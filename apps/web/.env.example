# Copy this file to `.env` and adjust as needed.

# Postgres connection string. The app targets Postgres everywhere now — there's
# no SQLite fallback, so local dev needs one too. On macOS the shortest path is
# `brew install postgresql@17 && brew services start postgresql@17` (README has
# the four lines that create the role and database); otherwise a free
# Neon/Supabase branch, or `vercel env pull` to borrow the deployed one.
# On Vercel, use the POOLED connection string — serverless opens many
# connections and the direct one will exhaust the server's limit.
DATABASE_URL="postgresql://user:password@localhost:5432/moto"

# The DIRECT (unpooled) endpoint for the same database. Migrations take advisory
# locks and issue DDL that a transaction-mode pooler won't carry, so `directUrl`
# in the schema points them here. Required locally too — every `prisma migrate`
# command errors (P1012) if it's unset. Against a plain local Postgres there's no pooler,
# so set it to the same value as DATABASE_URL. Neon's integration injects both.
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/moto"

# Vercel Blob read-write token. Leave it unset and image uploads are written to
# ./uploads on disk and served by /media — the zero-config local setup. Set it
# (Vercel adds it automatically once a Blob store is connected; `vercel env
# pull` brings it down locally) and the browser uploads straight to Blob
# instead. Read at runtime, so no rebuild is needed to switch.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# iron-session cookie encryption key. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# TEMPORARY: when "true", signed-out visitors can wave at posts without an
# account — they're tracked by a random id in a cookie instead. Leave it unset
# to require signing in. Inlined at build time (NEXT_PUBLIC_), so set it before
# `next build`, not after.
# NEXT_PUBLIC_ALLOW_ANONYMOUS_WAVES="true"
