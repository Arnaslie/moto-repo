{
  "name": "moto-repo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "npm run dev -w @moto/web",
    "build": "npm run build -w @moto/web",
    "start": "npm run start -w @moto/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @moto/web",
    "db:seed": "npm run db:seed -w @moto/web",
    "db:seed:catalog": "npm run db:seed:catalog -w @moto/web",
    "db:studio": "npm run db:studio -w @moto/web"
  }
}
